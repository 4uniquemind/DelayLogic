# New time-based AND gate function
def time_based_and_gate(input1, input2, K_param, omega_map, threshold_wn):
    Omega = omega_map.get((input1, input2))
    if Omega is None:
        # Fallback or error for undefined input combinations
        # For now, let's assume it results in a 0 output if not found
        return 0
    
    winding_number = calculate_winding_number(Omega, K_param)
    
    if winding_number >= threshold_wn:
        return 1
    else:
        return 0

# Функция задержки сигнала
def delay(x, dt):
    x = np.roll(x, dt)
    x[:dt] = 0
    return x

# Модифицированная операция венюнкция (sequential AND)
def seq(x, y, dt):
    # Задержка сигналов
    x_dt = delay(x, dt)
    y_dt = delay(y, dt)

    # Вычисление выхода
    result = np.zeros_like(x)

    for i in range(len(x)):
        result[i] = time_based_and_gate(x_dt[i], y_dt[i], K_PARAM, OMEGA_MAP, THRESHOLD_WN)

    # This part of the original code printed a summary, 
    # which might not be directly relevant for each call to seq if it's used as a component.
    # For now, let's keep it to see the overall effect on the example.
    if np.all(result == 1):
        print("x & y = 1 (based on time_based_and_gate for the entire sequence)")
    else:
        # This will print if any element in the result is 0
        print("x & y != 1 (at least one element is 0 in the time_based_and_gate sequence)")

    return result

# Пример использования
print(seq(np.array([1, 1, 1, 0, 1, 0]), np.array([0, 0, 1, 1, 1, 0]), 1))

