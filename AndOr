# New time-based AND gate function
def time_based_and_gate(input1, input2, K_param, omega_map, threshold_wn):
    """Implements a time-based AND gate using circle map dynamics.

    The logical output is determined by comparing the winding number, derived
    from circle map simulations, against a threshold. The specific Omega
    parameter for the circle map is chosen based on the binary inputs.

    Args:
        input1 (int): The first binary input (0 or 1).
        input2 (int): The second binary input (0 or 1).
        K_param (float): The K (coupling strength) parameter for the circle map.
        omega_map (dict): A dictionary mapping input tuples (e.g., (0,1))
                          to Omega parameters for the circle map.
        threshold_wn (float): The winding number threshold used to determine
                              the logical output (1 if >= threshold, else 0).

    Returns:
        int: The logical AND result (0 or 1).

    Raises:
        ValueError: If inputs are not valid binary integers.
    """
    if not isinstance(input1, (int, np.integer)) or input1 not in [0, 1]:
        raise ValueError(f"input1 must be an integer 0 or 1, got {input1}")
    if not isinstance(input2, (int, np.integer)) or input2 not in [0, 1]:
        raise ValueError(f"input2 must be an integer 0 or 1, got {input2}")

    Omega = omega_map.get((input1, input2))
    if Omega is None:
        # Fallback or error for undefined input combinations
        # For now, let's assume it results in a 0 output if not found
        # This case should ideally be handled by the omega_map definition
        # or specific error handling if inputs are valid but not in map.
        return 0 
    
    winding_number = calculate_winding_number(Omega, K_param)
    
    if winding_number >= threshold_wn:
        return 1
    else:
        return 0

# Функция задержки сигнала
def delay(x, dt):
    """Applies a delay to a signal (numpy array).

    The signal is rolled by dt positions, and the first dt elements
    of the rolled array are set to zero.

    Args:
        x (np.ndarray): The input signal (1D numpy array).
        dt (int): The delay amount (number of positions to roll and zero out).

    Returns:
        np.ndarray: The delayed signal.
    """
    x = np.roll(x, dt)
    x[:dt] = 0
    return x

# Модифицированная операция венюнкция (sequential AND)
def seq(x, y, dt, verbose=False):
    """Applies a time-based AND gate element-wise to two input sequences
    after applying a specified delay to them.

    Args:
        x (array-like): The first input sequence of binary values (0 or 1).
        y (array-like): The second input sequence of binary values (0 or 1).
                        Must be the same length as x.
        dt (int): The non-negative integer delay to apply to x and y before
                  processing.
        verbose (bool, optional): If True, prints a summary of whether the
                                  entire resulting sequence is all ones.
                                  Defaults to False.

    Returns:
        np.ndarray: A numpy array containing the element-wise AND results
                    after delay.

    Raises:
        ValueError: If dt is negative, or if x and y have different lengths
                    or are not 1-dimensional.
    """
    if not isinstance(dt, int) or dt < 0:
        raise ValueError("Delay dt must be a non-negative integer")

    # Convert inputs to numpy arrays to ensure compatibility
    x = np.asarray(x)
    y = np.asarray(y)

    if x.ndim != 1 or y.ndim != 1:
        raise ValueError("Input arrays x and y must be 1-dimensional")

    if len(x) != len(y):
        raise ValueError("Input arrays x and y must have the same length")
    
    gate_cache = {} # Initialize cache for time_based_and_gate results
        
    # Задержка сигналов
    x_dt = delay(x, dt)
    y_dt = delay(y, dt)

    # Вычисление выхода
    result = np.zeros_like(x)

    for i in range(len(x)): # Iterate based on original length of x
        current_pair = (x_dt[i], y_dt[i])
        if current_pair not in gate_cache:
            gate_cache[current_pair] = time_based_and_gate(
                current_pair[0], current_pair[1],
                K_PARAM, OMEGA_MAP, THRESHOLD_WN
            )
        result[i] = gate_cache[current_pair]

    if verbose:
        if np.all(result == 1):
            print("x & y = 1 (based on time_based_and_gate for the entire sequence)")
        else:
            # This will print if any element in the result is 0
            print("x & y != 1 (at least one element is 0 in the time_based_and_gate sequence)")

    return result

# Пример использования
print(seq(np.array([1, 1, 1, 0, 1, 0]), np.array([0, 0, 1, 1, 1, 0]), 1, verbose=True))

