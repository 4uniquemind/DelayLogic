import numpy as np

# --- Parameters for Time-Based Logic Gate ---

# K_PARAM: Coupling strength for the circle map.
# Chosen as 1.0, a common value for observing rich dynamics including frequency locking
# in the circle map, as seen in "Devil's Staircase" phenomena.
K_PARAM = 1.0

# OMEGA_MAP: Maps (input1, input2) pairs to Omega parameters for the circle map.
# Omega is the base frequency parameter. These values are chosen empirically
# to ensure that the resulting winding numbers for (1,1) inputs are distinctly
# higher than for other input combinations, relative to THRESHOLD_WN.
# (0,0) -> Omega=0.1 (expected WN ~0.1)
# (0,1) -> Omega=0.2 (expected WN ~0.2)
# (1,0) -> Omega=0.25 (expected WN ~0.25)
# (1,1) -> Omega=0.5 (expected WN ~0.5, corresponds to 1/2 locking)
OMEGA_MAP = {
    (0, 0): 0.1,
    (0, 1): 0.2,
    (1, 0): 0.25,
    (1, 1): 0.5
}

# THRESHOLD_WN: Winding number threshold for the time-based AND gate.
# If the calculated winding number for a given input pair is >= THRESHOLD_WN,
# the gate outputs 1, otherwise 0. This value (0.4) is chosen to clearly
# separate the expected winding number for (1,1) inputs (around 0.5) from
# the winding numbers for other inputs (<=0.25).
# IMPORTANT: The gate's correctness is sensitive to these Omega and Threshold values.
# Small changes to K_PARAM or issues affecting numerical precision of winding numbers
# could potentially shift winding numbers across this threshold.
THRESHOLD_WN = 0.4

# Copied from Stairs.py
def circle_map_step(theta_current, Omega, K):
    """Performs one iteration of the circle map.

    Args:
        theta_current (float): Current phase of the system (typically in [0, 1)).
        Omega (float): Base frequency parameter.
        K (float): Coupling strength parameter.

    Returns:
        float: The next phase value of the system (in [0, 1)).
    """
    theta_next = theta_current + Omega + (K / (2 * np.pi)) * np.sin(2 * np.pi * theta_current)
    return theta_next % 1 # Возвращаем остаток от деления на 1, чтобы фаза была [0, 1)

# Copied and modified from Stairs.py
def calculate_winding_number(Omega, K, num_iterations=200, transient=50):
    """Calculates the winding number for given Omega and K parameters.

    The winding number is the average phase change per iteration of the circle map
    after an initial transient period.

    Args:
        Omega (float): Base frequency parameter for the circle map.
        K (float): Coupling strength parameter for the circle map.
        num_iterations (int): Total number of iterations to simulate.
        transient (int): Number of initial iterations to discard.

    Returns:
        float: The calculated winding number.

    Raises:
        ValueError: If num_iterations is not greater than transient.
    """
    if num_iterations <= transient:
        raise ValueError("num_iterations must be greater than transient to calculate winding number")
    
    theta = 0.5 # Начальная фаза
    total_phase_change = 0.0
    # theta_unwrapped = theta # Фаза без взятия по модулю 1, для отслеживания полных оборотов

    # Пропускаем переходный процесс
    for _ in range(transient):
        theta_next_raw = theta + Omega + (K / (2 * np.pi)) * np.sin(2 * np.pi * theta)
        theta = theta_next_raw % 1

    # Вычисляем число вращения на установившемся режиме
    # theta_unwrapped = theta # Сбрасываем после транзиента
    for _ in range(num_iterations - transient):
        theta_next_raw = theta + Omega + (K / (2 * np.pi)) * np.sin(2 * np.pi * theta)
        total_phase_change += theta_next_raw - theta # Насколько фаза изменилась *до* взятия по модулю
        theta = theta_next_raw % 1
    
    if (num_iterations - transient) == 0:
        return 0 # Avoid division by zero if num_iterations <= transient
    winding_number = total_phase_change / (num_iterations - transient)
    return winding_number

